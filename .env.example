# Copy to .env (`make env` does this and generates random passwords).
# Never commit .env.

# --- PostgreSQL / TimescaleDB ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=anpr
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=anpr

# --- Redis (event queue) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis

# --- S3 object storage (plate / vehicle images) ---
# Dev: local SeaweedFS. Prod: any S3 endpoint (leave S3_ENDPOINT_URL empty for AWS S3).
S3_ENDPOINT_URL=http://localhost:8333
S3_PORT=8333
S3_REGION=us-east-1
S3_ACCESS_KEY=anpr
S3_SECRET_KEY=change-me-s3
S3_BUCKET=anpr-images
# Images older than this are deleted automatically (privacy / storage). 0 = keep forever.
IMAGE_RETENTION_DAYS=30

# --- API ---
API_PORT=8000

# --- Cameras ---
# Host used in config/cameras.yaml URLs.
RTSP_HOST=localhost
